[Unit]
Description=Kylin SafeOps Agent Backend
After=network.target

[Service]
Type=simple
User=kylin-safeops
Group=kylin-safeops
WorkingDirectory=/opt/kylin-safeops
ExecStart=/opt/kylin-safeops/.venv/bin/uvicorn backend.app.api.app:create_app --factory --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kylin-safeops

# ADR-0004：生产 KYLIN_LDAP_MOCK 必须 false（mock 仅 demo/单测）。
# systemd 硬编码兜底 + install.sh 写 /etc/kylin-safeops/ldap.env 二重保险。
Environment=KYLIN_LDAP_MOCK=false

# 安全加固
# 注意：本单元【故意不设】NoNewPrivileges——app 进程需保留 setuid 能力，
# 才能经 sudo 调 wrapper（deploy/sandbox/kylin-safeops-run.sh）拉起沙箱。
# NoNewPrivileges 会让内核吞掉 sudo 的 setuid 提权（sudo 报"no new privileges
# 阻止以 root 运行"），沙箱一开则所有需提权工具全失败（B3 麒麟 VM 实证坐实）。
# 真正的 NNP 隔离在 wrapper 内层 systemd-run（-p NoNewPrivileges=yes），
# 施加到【被执行的工具】而非 app 进程本身——两者独立，删此处不削弱沙箱。
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kylin-safeops
ReadOnlyPaths=/etc

[Install]
WantedBy=multi-user.target
