[Unit]
Description=Kylin SafeOps Agent Backend (proxy 模式，仅监听 127.0.0.1)
After=network.target
# 确保 NTP 时钟已同步（防重放 ±300s 窗口依赖时钟准确）
After=time-sync.target

[Service]
Type=simple
User=kylin-safeops
Group=kylin-safeops
UMask=0077

WorkingDirectory=/opt/kylin-safeops

# 环境变量从受限文件读取（0600 root:kylin-safeops，含密钥，绝不入库）
EnvironmentFile=/etc/kylin-safeops/agent.env

# ADR-0004：生产 KYLIN_LDAP_MOCK 必须 false（mock 仅 demo/单测）。
# 本行为 unit 侧声明；agent.env 亦由 install.sh 写入 false，两处同值。
# 注：systemd 中 EnvironmentFile= 与 Environment= 的优先级以 systemd.exec(5) 为准，
# 本注释不对覆盖顺序作保证——真正的 fail-closed 兜底在 backend/app/api/app.py
# （proxy 模式检出 KYLIN_LDAP_MOCK=true 直接 RuntimeError 拒启动）。
# 部署时用 `systemctl show kylin-safeops-agent -p Environment` 核对实际取值。
Environment=KYLIN_LDAP_MOCK=false

# 之七十五 H-2：SSE 事件队列上限双保险（代码默认亦为 512，此处显式声明便于运维审查/调优）。
Environment=KYLIN_SSE_QUEUE_MAX=512

# app 绑 127.0.0.1：只反代可达，杜绝直接对外暴露
ExecStart=/opt/kylin-safeops/.venv/bin/uvicorn \
    backend.app.api.app:create_app \
    --factory \
    --host 127.0.0.1 \
    --port 8000

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kylin-safeops-agent

# ── 安全加固 ──────────────────────────────────────────────
# 注意：本单元【故意不设】NoNewPrivileges——app 进程需保留 setuid 能力，
# 才能经 sudo 调 wrapper（deploy/sandbox/kylin-safeops-run.sh）拉起沙箱。
# NoNewPrivileges 会让内核吞掉 sudo 的 setuid 提权，沙箱一开则所有需提权
# 工具全失败（B3 麒麟 VM 实证坐实）。真正的 NNP 隔离在 wrapper 内层
# systemd-run，施加到【被执行的工具】而非 app 进程本身，删此处不削弱沙箱。
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# app 需写审计库（KYLIN_AUDIT_DB 指向的目录）+ 可能的 data/ 目录
ReadWritePaths=/opt/kylin-safeops /var/lib/kylin-safeops
ReadOnlyPaths=/etc/kylin-safeops

[Install]
WantedBy=multi-user.target
