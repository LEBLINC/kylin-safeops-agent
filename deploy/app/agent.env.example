# /etc/kylin-safeops/agent.env — app 侧环境变量（示例，勿将真密钥入库！）
# 权限：chmod 0600 /etc/kylin-safeops/agent.env
# 所有者：chown root:kylin-safeops /etc/kylin-safeops/agent.env

# ── 认证模式 ──────────────────────────────────────────────────────────────
# 生产必须为 proxy；dev 模式严禁用于生产（角色可伪造）
KYLIN_AUTH_MODE=proxy

# ── 反代签名共享密钥 ───────────────────────────────────────────────────────
# 生成示例（bash）：python3 -c "import secrets; print(secrets.token_hex(32))"
# 同一密钥须配置到反代（Nginx/Apache）——app 侧与反代侧必须完全一致（含大小写）
# 警告：此密钥绝不进前端、绝不入版本库、绝不写日志
KYLIN_PROXY_AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_64HEX

# ── 沙箱（systemd 瞬态 service）──────────────────────────────────────────
# 麒麟 Linux 生产部署启用；Windows / 非 Linux 不可设为 1
KYLIN_SANDBOX_ENABLED=1

# ── 审计库路径（审计硬化 3a 落地后启用，绝对路径 + 受限权限）──────────────
# KYLIN_AUDIT_DB=/var/lib/kylin-safeops/audit.db
# 目录权限示例：
#   install -d -m 0700 -o kylin-safeops -g kylin-safeops /var/lib/kylin-safeops
