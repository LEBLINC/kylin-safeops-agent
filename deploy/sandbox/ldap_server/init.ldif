# Kylin SafeOps Agent — P1b 真 LDAP 端到端实证初始数据
# 范围：仅用于麒麟 V11 + LoongArch VM 实证；非生产数据。
# 部署见同目录 README.md。
#
# 结构：
#   dc=kylin,dc=test
#   ├── ou=users
#   │     uid=alice / operator1 / viewer1 / auditor1
#   └── ou=groups
#         cn=kylin-admins   (member: alice)
#         cn=kylin-ops      (member: operator1)
#         cn=kylin-viewers  (member: viewer1)
#         cn=kylin-auditors (member: auditor1)
#
# 用户口令：占位符 __USER_PW_HASH__，由 VM runbook 用
#   slappasswd -s "$KYLIN_LDAP_USER_PW"
# 现场生成 SSHA hash 后 sed 替换。
# S9 铁律：不把任何 hash/明文口令 commit 进仓库。

#--- 根 ---
dn: dc=kylin,dc=test
objectClass: top
objectClass: domain
dc: kylin

#--- 组织单元 ---
dn: ou=users,dc=kylin,dc=test
objectClass: top
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=kylin,dc=test
objectClass: top
objectClass: organizationalUnit
ou: groups

#--- 用户：alice（admin 角色）---
dn: uid=alice,ou=users,dc=kylin,dc=test
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: alice
cn: Alice Admin
sn: Admin
givenName: Alice
mail: alice@kylin.test
userPassword: __USER_PW_HASH__

#--- 用户：operator1（operator 角色）---
dn: uid=operator1,ou=users,dc=kylin,dc=test
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: operator1
cn: Operator One
sn: One
givenName: Operator
mail: operator1@kylin.test
userPassword: __USER_PW_HASH__

#--- 用户：viewer1（viewer 角色）---
dn: uid=viewer1,ou=users,dc=kylin,dc=test
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: viewer1
cn: Viewer One
sn: One
givenName: Viewer
mail: viewer1@kylin.test
userPassword: __USER_PW_HASH__

#--- 用户：auditor1（auditor 角色）---
dn: uid=auditor1,ou=users,dc=kylin,dc=test
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: auditor1
cn: Auditor One
sn: One
givenName: Auditor
mail: auditor1@kylin.test
userPassword: __USER_PW_HASH__

#--- 组：kylin-admins（成员：alice）---
dn: cn=kylin-admins,ou=groups,dc=kylin,dc=test
objectClass: top
objectClass: groupOfNames
cn: kylin-admins
description: Kylin SafeOps admin role
member: uid=alice,ou=users,dc=kylin,dc=test

#--- 组：kylin-ops（成员：operator1）---
dn: cn=kylin-ops,ou=groups,dc=kylin,dc=test
objectClass: top
objectClass: groupOfNames
cn: kylin-ops
description: Kylin SafeOps operator role
member: uid=operator1,ou=users,dc=kylin,dc=test

#--- 组：kylin-viewers（成员：viewer1）---
dn: cn=kylin-viewers,ou=groups,dc=kylin,dc=test
objectClass: top
objectClass: groupOfNames
cn: kylin-viewers
description: Kylin SafeOps viewer role
member: uid=viewer1,ou=users,dc=kylin,dc=test

#--- 组：kylin-auditors（成员：auditor1）---
dn: cn=kylin-auditors,ou=groups,dc=kylin,dc=test
objectClass: top
objectClass: groupOfNames
cn: kylin-auditors
description: Kylin SafeOps auditor role
member: uid=auditor1,ou=users,dc=kylin,dc=test
