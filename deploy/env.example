# B5 commit 4: 部署 env 注释(参考示例;实际 env 由 deploy/install.sh + kylin-safeops.service 注入)
# ---- 日志模式(B4 L-H16 / B5 commit 4 治债) ----
# KYLIN_LOG_MODE=production  → JSON formatter (Loki/ELK 友好聚合)
# KYLIN_LOG_MODE=development (默认) → console formatter (人眼友好)

# ---- EventBus queue(B4 L-H14 / B5 commit 4 治债) ----
# KYLIN_SSE_QUEUE_MAX=100  → /api/system/ready registry 阈值 (active_count < 该值即 ready)

# ---- 请求体大小上限(B5 L-M5) ----
# KYLIN_MAX_REQUEST_BYTES=1048576  → RequestSizeLimitMiddleware 1MB (默认)

# ---- nonce 防重放存储后端(A1 P4) ----
# KYLIN_NONCE_STORE=memory (默认,单进程 dev) | redis (multi-replica 部署必设)
# KYLIN_REDIS_URL=redis://localhost:6379/0  → KYLIN_NONCE_STORE=redis 时必设

# ---- LDAP 真接模式(A2, 决策⑨ 硬阻断) ----
# KYLIN_LDAP_MOCK=false  → 生产必设(true 时 + KYLIN_AUTH_MODE=proxy 启动期 fail-closed 拒启, ADR-0004)