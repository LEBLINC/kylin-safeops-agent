# KYLIN_LDAP_* 6 env (deploy/install.sh 拷此到 /etc/kylin-safeops/ldap.env)
# 替换 <PLACEHOLDER> 后 chmod 600 + 运维持有
KYLIN_LDAP_URL=ldap://ldap.kylin.local:389
KYLIN_LDAP_BIND_DN=cn=svc,ou=system,dc=kylin,dc=local
KYLIN_LDAP_BIND_PW=<PLACEHOLDER>
KYLIN_LDAP_USER_BASE=ou=users,dc=kylin,dc=local
KYLIN_LDAP_USER_FILTER=(uid={username})
# JSON map: LDAP group → app role (lowercase)
KYLIN_LDAP_GROUP_ROLE_MAP={"kylin-admins":"admin","kylin-ops":"operator","kylin-auditors":"auditor"}
